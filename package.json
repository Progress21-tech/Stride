{
  "name": "sylpace-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=24.11.0 <25" },
  "scripts": {
    "dev:marketing": "pnpm --filter @sylpace/marketing dev",
    "build:marketing": "pnpm --filter @sylpace/marketing build",
    "dev:app": "pnpm --filter @sylpace/app dev",
    "build:app": "pnpm --filter @sylpace/app build",
    "dev:api": "pnpm --filter @sylpace/api dev",
    "lint": "pnpm --filter '!@sylpace/legacy-app' -r --if-present lint",
    "typecheck": "pnpm --filter '!@sylpace/legacy-app' -r --if-present typecheck",
    "test": "pnpm --filter '!@sylpace/legacy-app' -r --if-present test",
    "check:supabase-imports": "node scripts/check-supabase-imports.mjs"
  }
}
