{
  "name": "@sylpace/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./src/client.ts", "import": "./src/client.ts" } },
  "scripts": {
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "@prisma/adapter-pg": "7.10.0", "@prisma/client": "7.10.0", "pg": "^8.13.3" },
  "devDependencies": { "@types/node": "^22.13.10", "@types/pg": "^8.11.11", "dotenv": "^16.4.7", "prisma": "7.10.0", "typescript": "^5.8.2" }
}
