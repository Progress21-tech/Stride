# Marketing app. Set public origins for local metadata generation.
NEXT_PUBLIC_MARKETING_URL=https://sylpace.example
NEXT_PUBLIC_APP_URL=https://app.sylpace.example
MARKETING_INDEXING_ENABLED=false

# Sylpace API and PostgreSQL (managed provider decision D6 is still open).
DATABASE_URL=
REDIS_URL=
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Local browser API origin. Leave unset on Vercel; same-domain /api routing is used there.
NEXT_PUBLIC_API_URL=http://localhost:4000
SYLPACE_APP_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Waitlist records live in the temporary Supabase project until migration/cutover is approved.

# Legacy app only, pending D8 migration/cutover decision. Never use for new modules.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
# Waitlist API uses Supabase's public anon key; RLS allows insert only and owner-only select.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key

# OAuth credentials are configured only after the first-party identity ADR and provider setup.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
