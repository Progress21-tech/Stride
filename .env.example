# ============================================================================
# STRIDE PLATFORM — ENVIRONMENT VARIABLES FOR VERCEL & SUPABASE
# ============================================================================

# 1. Supabase Project Configuration (From Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Supabase Server-Side Service Role Key (For Admin server actions & approvals)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. Production App Domain URL
NEXT_PUBLIC_APP_URL=https://your-stride-app.vercel.app

# 4. Optional: Resend Email Provider (For transactional emails per PRD Section 17)
RESEND_API_KEY=re_123456789_your_resend_api_key_here
