NEXT_PUBLIC_APP_URL=https://app.sylpace.example
MARKETING_INDEXING_ENABLED=false

# Sylpace API and PostgreSQL (managed provider decision D6 is still open).
DATABASE_URL=
REDIS_URL=
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
SYLPACE_APP_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=

