    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "20.17.30",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.22.0",
    "dotenv": "^16.4.7",
    "eslint-config-next": "16.4.0",
    "sharp": "^0.33.5",
    "typescript": "5.8.3"
  }
